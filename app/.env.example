VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Ben dashboard (second Vercel project) — needs BOTH vars:
#   VITE_SUPABASE_ANON_KEY   same value as above (Kong gateway requires the registered anon key)
#   VITE_BEN_SUPABASE_ANON_KEY  ben_viewer JWT — goes in Authorization header only
#                                sets PostgreSQL role to ben_viewer (views only, no raw table access)
#                                Generate: node scripts/gen_ben_jwt.mjs <JWT_SECRET>
#                                JWT secret: Supabase dashboard → Settings → API → JWT Secret
VITE_BEN_SUPABASE_ANON_KEY=
